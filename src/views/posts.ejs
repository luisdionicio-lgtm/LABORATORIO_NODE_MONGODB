<!DOCTYPE html><html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Nexo | Publicaciones</title><link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@600;700;800&display=swap" rel="stylesheet"><link rel="stylesheet" href="/css/styles.css"></head><body>
<header class="site-header"><a class="brand" href="/"><span class="brand-mark">N</span>Nexo</a><nav><a class="nav-link" href="/">Inicio</a><a class="nav-link active" href="/posts">Publicaciones</a></nav></header>
<main class="page-shell"><section class="page-heading"><div><span class="eyebrow">Historias de la comunidad</span><h1>Publicaciones</h1><p>Descubre ideas, experiencias y momentos compartidos.</p></div><a class="button button-primary" href="/posts/new"><span>＋</span> Nueva publicación</a></section>
<% const messages={created:'La publicación se creó correctamente.',updated:'Los cambios se guardaron correctamente.',deleted:'La publicación se eliminó correctamente.'}; %><% if(messages[notice]){ %><div class="notice" role="status"><span>✓</span><%= messages[notice] %></div><% } %>
<% if(!posts.length){ %><section class="empty-state"><div>✦</div><h2>Aún no hay publicaciones</h2><p>Sé la primera persona en compartir una historia con la comunidad.</p><a class="button button-primary" href="/posts/new">Crear la primera</a></section><% }else{ %><section class="post-grid" aria-label="Lista de publicaciones"><% posts.forEach(post=>{ %><article class="post-card"><div class="post-media"><% if(post.imageUrl){ %><img src="<%= post.imageUrl %>" alt="Imagen de <%= post.title %>"><% }else{ %><div class="image-placeholder"><span>N</span></div><% } %><div class="card-actions"><a href="/posts/<%= post._id %>/edit" aria-label="Editar <%= post.title %>">✎</a><form method="POST" action="/posts/<%= post._id %>/delete" onsubmit="return confirm('¿Eliminar esta publicación?');"><button type="submit" aria-label="Eliminar <%= post.title %>">×</button></form></div></div><div class="post-content"><div class="post-meta"><span class="avatar"><%= post.user?.name?.charAt(0)||'N' %></span><div><strong><%= post.user?`${post.user.name} ${post.user.lastName||''}`:'Usuario' %></strong><small><%= new Intl.DateTimeFormat('es-PE',{day:'2-digit',month:'short',year:'numeric'}).format(new Date(post.createdAt)) %></small></div></div><h2><%= post.title %></h2><p><%= post.content %></p><% if(post.hashtags?.length){ %><div class="tags"><% post.hashtags.forEach(tag=>{ %><span>#<%= tag.replace('#','') %></span><% }) %></div><% } %></div></article><% }) %></section><% } %></main></body></html>
