<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Nexo | Usuarios</title>
  <link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body class="page-users">
  <%- include('partials/ambient') %>
  <%- include('partials/header', { activePage: 'users' }) %>
  <main class="users-shell">
    <section class="users-heading reveal">
      <div><div class="signal"><i></i><span>IDENTIDADES NEXO</span><b><%= String(users.length).padStart(2,'0') %> PERFILES</b></div><h1>Personas que dan<br><em>vida a las ideas.</em></h1></div>
      <p>Registra un nuevo perfil para publicar historias y formar parte de la comunidad.</p>
    </section>

    <% if(notice === 'created'){ %><div class="toast reveal" role="status"><i>✓</i><span><strong>Usuario registrado</strong>El nuevo perfil ya puede crear publicaciones.</span></div><% } %>

    <section class="users-layout">
      <div class="user-list reveal">
        <div class="section-label"><span>COMUNIDAD</span><b>PERFILES ACTIVOS</b></div>
        <% if(!users.length){ %><div class="users-empty"><span>＋</span><h2>Aún no hay usuarios</h2><p>Completa el formulario para crear el primer perfil.</p></div><% } %>
        <% users.forEach((user,index)=>{ %><article class="user-card"><div class="user-avatar"><span><%= user.name.charAt(0) %><%= user.lastName.charAt(0) %></span><i></i></div><div class="user-info"><small>USUARIO <%= String(index+1).padStart(2,'0') %></small><h2><%= user.name %> <%= user.lastName %></h2><p><%= user.email %></p><div><span><b><%= user.age %></b> años</span><span><b><%= user.phoneNumber || '—' %></b> teléfono</span></div></div><span class="user-status">ACTIVO</span></article><% }) %>
      </div>

      <div class="user-create reveal">
        <div class="panel-heading"><span>NUEVO USUARIO</span><b>REGISTRO</b></div>
        <form class="post-form user-form" method="POST" action="/users">
          <% if(error){ %><div class="form-error" role="alert"><i>!</i><span><strong>No se pudo registrar</strong><%= error %></span></div><% } %>
          <div class="field-row"><label><span><b>01</b>Nombre</span><input name="name" value="<%= formData.name || '' %>" required placeholder="Luis"></label><label><span><b>02</b>Apellido</span><input name="lastName" value="<%= formData.lastName || '' %>" required placeholder="Dionicio"></label></div>
          <label><span><b>03</b>Correo electrónico</span><input type="email" name="email" value="<%= formData.email || '' %>" required placeholder="usuario@correo.com"></label>
          <div class="field-row"><label><span><b>04</b>Edad</span><input type="number" name="age" value="<%= formData.age || '' %>" min="18" required placeholder="18"><small>Debe ser mayor de edad.</small></label><label><span><b>05</b>Teléfono <em>opcional</em></span><input type="tel" name="phoneNumber" value="<%= formData.phoneNumber || '' %>" placeholder="999 999 999"></label></div>
          <label><span><b>06</b>Contraseña</span><input type="password" name="password" minlength="8" required placeholder="Mínimo 8 caracteres" autocomplete="new-password"><small>La contraseña nunca se muestra en el listado.</small></label>
          <div class="form-actions"><span class="privacy-note">DATOS PROTEGIDOS</span><button class="btn btn-glow magnetic" type="submit"><span>Crear usuario</span><b>→</b></button></div>
        </form>
      </div>
    </section>
  </main>
  <%- include('partials/footer') %>
</body>
</html>
